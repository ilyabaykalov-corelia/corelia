# Адреса должны быть доступны из контейнеров. Для сервиса на Mac используйте host.docker.internal.
PLATFORM_V_KEYCLOAK_BASE_URL=
# PLATFORM_V_KEYCLOAK_ISSUER=
# PLATFORM_V_KEYCLOAK_JWKS_URL=
# PLATFORM_V_KEYCLOAK_TOKEN_URL=
# PLATFORM_V_KEYCLOAK_LOGOUT_URL=
PLATFORM_V_KEYCLOAK_CLIENT_ID=PlatformAuth-Proxy
PLATFORM_V_DATASPACE_GRAPHQL_URL=
PLATFORM_V_BPMX_BASE_URL=
PLATFORM_V_TASK_LIST_BASE_URL=
PLATFORM_V_FILE_STORAGE_BASE_URL=
PLATFORM_V_TENANT=
PLATFORM_V_APP_INSTANCE_ID=
CORS_ORIGIN=http://localhost:5173
MAX_BODY_SIZE_MB=35
CORELIA_AUTH_PROVIDER=keycloak
# Уровень событий Corelia: INFO показывает структурированные JSON-события интеграций.
CORELIA_LOG_LEVEL=INFO

# Порты JDWP на localhost; включаются только через ./scripts/up.sh --debug.
CORELIA_GATEWAY_DEBUG_PORT=5005
CORELIA_AUTH_DEBUG_PORT=5006
CORELIA_DOCUMENT_DEBUG_PORT=5007
CORELIA_WORKFLOW_DEBUG_PORT=5008
CORELIA_ATTACHMENT_DEBUG_PORT=5009
